# Copy to .env on the VM and fill in real values. Never commit the real .env.
DB_USERNAME=postgres
DB_PASSWORD=changeme
IMAGE_PREFIX=ghcr.io/OWNER/REPO
IMAGE_TAG=latest
# Must match the URL the frontend is actually served at (scheme + host + port) —
# room-service/pricing-service reject cross-origin browser requests otherwise.
CORS_ALLOWED_ORIGIN=http://YOUR_VM_PUBLIC_IP:3000
