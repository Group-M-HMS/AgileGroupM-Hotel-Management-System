<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
  NIBM2 Selenium End-to-End Automation Suite.
  Organized cleanly into functional feature blocks covering Authentication,
  Dashboard & History, Itinerary & Cancellation, Checkout & Stripe Payment,
  and Booking Confirmation.
-->
<suite name="NIBM2 Hotel Management Automation Suite" verbose="1" parallel="none">

    <test name="Authentication & Security Tests">
        <classes>
            <class name="com.nibm2.tests.LoginTest"/>
            <class name="com.nibm2.tests.RegisterTest"/>
            <class name="com.nibm2.tests.LoginSecurityTest"/>
            <class name="com.nibm2.tests.LogoutTest"/>
            <class name="com.nibm2.tests.ProfileTest"/>
            <class name="com.nibm2.tests.CheckoutAuthTest"/>
            <class name="com.nibm2.tests.NavigationAuthTest"/>
        </classes>
    </test>

    <test name="Account Dashboard & Booking Management Tests">
        <classes>
            <class name="com.nibm2.tests.MyBookingsNavTest"/>
            <class name="com.nibm2.tests.DashboardEmptyStateTest"/>
            <class name="com.nibm2.tests.DashboardUpcomingBookingsTest"/>
            <class name="com.nibm2.tests.DashboardPastBookingsTest"/>
            <class name="com.nibm2.tests.DashboardBookingStatusTest"/>
            <class name="com.nibm2.tests.DashboardGuestSpecialRequestsTest"/>
            <class name="com.nibm2.tests.BookingLookupDashboardTest"/>
            <class name="com.nibm2.tests.DashboardLogoNavigationTest"/>
        </classes>
    </test>

    <test name="Booking Itinerary & Cancellation Workflow Tests">
        <classes>
            <class name="com.nibm2.tests.DashboardItineraryPrintTest"/>
            <class name="com.nibm2.tests.DashboardItinerarySecurityTest"/>
            <class name="com.nibm2.tests.DashboardCancellationEligibilityTest"/>
            <class name="com.nibm2.tests.DashboardCancelModalWarningTest"/>
            <class name="com.nibm2.tests.DashboardCancelWorkflowTest"/>
            <class name="com.nibm2.tests.DashboardCancelStatusBackendConfirmationTest"/>
            <class name="com.nibm2.tests.DashboardCancelButtonRemovalTest"/>
            <class name="com.nibm2.tests.DashboardRoomInventoryReleaseTest"/>
            <class name="com.nibm2.tests.DashboardCancelSuccessBannerTest"/>
        </classes>
    </test>

    <test name="Checkout & Stripe Payment Processing Tests">
        <classes>
            <class name="com.nibm2.tests.DashboardCheckoutAutoFillTest"/>
            <class name="com.nibm2.tests.DashboardCheckoutValidationTest"/>
            <class name="com.nibm2.tests.DashboardTermsValidationTest"/>
            <class name="com.nibm2.tests.DashboardCardPaymentEnforcementTest"/>
            <class name="com.nibm2.tests.DashboardStripeIntegrationTest"/>
            <class name="com.nibm2.tests.DashboardBookingPaymentWorkflowTest"/>
            <class name="com.nibm2.tests.DashboardDuplicateSubmissionPreventionTest"/>
        </classes>
    </test>

    <test name="Booking Confirmation & Reference Uniqueness Tests">
        <classes>
            <class name="com.nibm2.tests.DashboardBookingReferenceUniquenessTest"/>
            <class name="com.nibm2.tests.DashboardConfirmationScreenGuidanceTest"/>
        </classes>
    </test>

</suite>
