# Copy to .env on the VM and fill in real values. Never commit the real .env.
DB_USERNAME=postgres
DB_PASSWORD=changeme
IMAGE_PREFIX=ghcr.io/OWNER/REPO
IMAGE_TAG=latest
# Must match the URL the frontend is actually served at (scheme + host + port) —
# room-service/pricing-service reject cross-origin browser requests otherwise.
CORS_ALLOWED_ORIGIN=http://YOUR_VM_PUBLIC_IP:3000

# Stripe TEST-mode secret key (sk_test_...) for payment-service. Get it from
# https://dashboard.stripe.com/test/apikeys . Falls back to a non-functional
# placeholder if unset, so the container still boots but real Stripe calls fail.
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
# REQUIRED shared secret for service-to-service calls (room, user, booking, payment).
# One value for all services. No default: compose refuses to start without it.
# Generate with: openssl rand -hex 32
INTERNAL_SERVICE_SECRET=
